# =========================
# 编译生成的文件 (Compiled files)
# =========================
# 可执行文件
*.exe
*.dll
*.so
*.dylib
*.out
*.app

# 对象文件
*.o
*.obj

# 预编译头文件
*.pch
*.gch

# 静态库和动态库
*.a
*.lib
*.so.*
*.dylib.*

# =========================
# 构建系统目录 (Build directories)
# =========================
# CMake
build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json

# Make
bin/
obj/
Debug/
Release/
x64/
x86/

# Conan (C++ 包管理器)
conanfile.py.lock
conan.lock

# Vcpkg
vcpkg_installed/

